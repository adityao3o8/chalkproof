# === LLM Providers ===
# At least one provider key is required. GENERATOR_MODEL and QC_MODEL must differ.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google (Gemini via OpenAI-compatible or google generative)
GOOGLE_API_KEY=

# Model IDs — use different models (ideally different providers) for independence
# Examples: openai:gpt-4o-mini | anthropic:claude-3-5-haiku-latest | openai:gpt-4o
GENERATOR_MODEL=openai:gpt-4o-mini
QC_MODEL=anthropic:claude-3-5-haiku-latest

# LLM timeouts (seconds)
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# === Research APIs ===
# Tavily (preferred). If empty, DuckDuckGo is used as fallback.
TAVILY_API_KEY=

# YouTube Data API v3 (optional — video search degrades gracefully without it)
YOUTUBE_API_KEY=

# Google Books (optional — Open Library is always tried first)
GOOGLE_BOOKS_API_KEY=

# === App ===
DATABASE_URL=sqlite:///./chalkproof.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true to force fixture lesson + programmatic QC (no LLM calls).
# Also auto-enabled when no LLM API keys are set.
CHALKPROOF_DEMO_MODE=false
